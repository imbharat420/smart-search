# Copy to .env and fill in AT LEAST ONE key below. Any single one enables chat.
# The backend tries them in order and falls back automatically, so setting two
# or three free keys makes rate limits (429s) invisible.

# --- Free providers -------------------------------------------------------
# NOTE: keep key lines bare — the .env parser keeps an inline comment after an
# EMPTY value as the value itself, which then reads as a (garbage) key.

# https://console.groq.com/keys — fast, generous free tier (chat only)
GROQ_API_KEY=
# https://cloud.cerebras.ai/ — free daily token allowance (chat only)
CEREBRAS_API_KEY=
# https://aistudio.google.com/apikey — free tier + embeddings
GEMINI_API_KEY=
# https://build.nvidia.com/ — free credits + embeddings
NVIDIA_API_KEY=
# https://z.ai/manage-apikey/apikey-list — GLM flash free (chat only on api.z.ai)
ZAI_API_KEY=
# https://console.mistral.ai/api-keys — free tier + embeddings (MISTRAL_AI also accepted)
MISTRAL_API_KEY=
# https://cloud.sambanova.ai/ — free tier + embeddings
SAMBANOVA_API_KEY=
# https://dashboard.cohere.com/api-keys — trial key + embeddings
COHERE_API_KEY=
# https://openrouter.ai/keys — :free models, chat only
OPENROUTER_API_KEY=
# https://huggingface.co/settings/tokens — free credits + embeddings
# (HF_TOKEN / HUGGINGFACEHUB_ACCESS_TOKEN also accepted)
HUGGINGFACE_API_KEY=

# --- Paid, optional -------------------------------------------------------
# https://platform.deepseek.com/api_keys — cheap pay-per-use, chat only
DEEPSEEK_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Selection ------------------------------------------------------------
# auto = first provider in LLM_FALLBACK that has a key. Or pin one:
# groq | cerebras | gemini | nvidia | zai | mistral | sambanova | cohere |
# openrouter | huggingface | deepseek | openai
LLM_PROVIDER=auto
LLM_FALLBACK=groq,cerebras,gemini,nvidia,zai,mistral,sambanova,cohere,openrouter,huggingface,deepseek,openai
LLM_TIMEOUT=30                # seconds per request before moving down the chain
CHAT_TEMPERATURE=0.3

# --- Model overrides (blank = the default in app/providers.py) -------------
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
CEREBRAS_CHAT_MODEL=llama-3.3-70b
GEMINI_CHAT_MODEL=gemini-2.5-flash
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
ZAI_CHAT_MODEL=glm-4.5-flash
MISTRAL_CHAT_MODEL=mistral-small-latest
SAMBANOVA_CHAT_MODEL=Meta-Llama-3.3-70B-Instruct
COHERE_CHAT_MODEL=command-a-03-2025
# OpenRouter :free ids churn — current list: https://openrouter.ai/models?max_price=0
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
DEEPSEEK_CHAT_MODEL=deepseek-chat
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings — Groq, Cerebras, Z.AI (global endpoint), OpenRouter and DeepSeek
# serve chat only, so /search uses the first of these that has a key (and
# lexical scoring if none do).
GEMINI_EMBED_MODEL=gemini-embedding-001
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
MISTRAL_EMBED_MODEL=mistral-embed
SAMBANOVA_EMBED_MODEL=E5-Mistral-7B-Instruct
COHERE_EMBED_MODEL=embed-v4.0
HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBED_MODEL=text-embedding-3-small

# Relevance calibration. Each embedding family has its own similarity range, so
# defaults ship per provider (app/providers.py); leave these commented unless
# match % looks off — setting them overrides EVERY provider with one band.
# EMBED_SIM_LO=0.16
# EMBED_SIM_HI=0.52
# EMBED_MIN_PRODUCT_SIM=0.20
# EMBED_MIN_POLICY_SIM=0.28

# --- Assistant: reranking and conversational state -------------------------
# The rerank pass scores a shortlist with the chat model, which attends to query
# and candidate together in a way two independently embedded vectors cannot. It
# costs one extra completion per chat turn — off falls back to the similarity
# order rag.py already produced, which is a documented degradation rather than a
# broken feature. /health reports which you are getting.
# RERANK_ENABLED=true
# RERANK_TIMEOUT=12.0        # exceeded -> keep the retrieval order
# RERANK_CANDIDATES=24       # shortlist size; rerank.py caps at 30 regardless

# Raw dialogue turns sent alongside the six-slot plan. Deliberately small: the
# plan IS the memory (app/plan.py), and this window only carries tone and "what
# did I just say". It was 8 before the plan existed, and the model had to
# re-derive the plan from scrollback on every turn.
# ASSISTANT_HISTORY_TURNS=4

# Conversational state is stored in the assistant_sessions table when
# DATABASE_URL is set, and in a bounded in-process dict otherwise — so the
# assistant keeps working with no Postgres, it just forgets on restart.

# --- Observability: LangSmith tracing ---------------------------------------
# A key turns each chat turn into a LangSmith trace of the whole pipeline
# (parse -> plan merge -> retrieve -> rerank -> generate, with real inputs and
# outputs at every stage). Unset = tracing off; /metrics and
# /admin/observability keep serving the in-process numbers either way.
# LANGSMITH_API_KEY=            # https://smith.langchain.com -> Settings -> API Keys
# LANGSMITH_PROJECT=traveliq-assistant
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # or https://eu.api.smith.langchain.com

# Comma-separated is not parsed; edit app/config.py if you need different origins.
# CORS defaults to the Vite dev server (http://localhost:5173).
