# Copy to .env and fill in AT LEAST ONE key below. Any single one enables chat.
# The backend tries them in order and falls back automatically, so setting two
# or three free keys makes rate limits (429s) invisible.

# --- Free providers -------------------------------------------------------
GROQ_API_KEY=                 # https://console.groq.com/keys      (fast, generous free tier)
CEREBRAS_API_KEY=             # https://cloud.cerebras.ai/         (free daily token allowance)
GEMINI_API_KEY=               # https://aistudio.google.com/apikey (free tier + embeddings)
NVIDIA_API_KEY=               # https://build.nvidia.com/          (free credits + embeddings)
ZAI_API_KEY=                  # https://z.ai/manage-apikey/apikey-list (GLM flash free + embeddings)

# --- Paid, optional -------------------------------------------------------
OPENAI_API_KEY=               # https://platform.openai.com/api-keys

# --- Selection ------------------------------------------------------------
# auto = first provider in LLM_FALLBACK that has a key.
# Or pin one: groq | cerebras | gemini | nvidia | zai | openai
LLM_PROVIDER=auto
LLM_FALLBACK=groq,cerebras,gemini,nvidia,zai,openai
LLM_TIMEOUT=30                # seconds per request before moving down the chain
CHAT_TEMPERATURE=0.3

# --- Model overrides (blank = the default in app/providers.py) -------------
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
CEREBRAS_CHAT_MODEL=llama-3.3-70b
GEMINI_CHAT_MODEL=gemini-2.5-flash
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
ZAI_CHAT_MODEL=glm-4.5-flash
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings — Groq and Cerebras serve chat only, so /search uses the first of
# these that has a key (and lexical scoring if none do).
GEMINI_EMBED_MODEL=gemini-embedding-001
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
ZAI_EMBED_MODEL=embedding-3
OPENAI_EMBED_MODEL=text-embedding-3-small

# Relevance calibration. Each embedding family has its own similarity range, so
# defaults ship per provider; override here if match % looks off for yours.
# EMBED_SIM_LO=0.16
# EMBED_SIM_HI=0.52
# EMBED_MIN_PRODUCT_SIM=0.20
# EMBED_MIN_POLICY_SIM=0.28

# --- Assistant: reranking and conversational state -------------------------
# The rerank pass scores a shortlist with the chat model, which attends to query
# and candidate together in a way two independently embedded vectors cannot. It
# costs one extra completion per chat turn — off falls back to the similarity
# order rag.py already produced, which is a documented degradation rather than a
# broken feature. /health reports which you are getting.
# RERANK_ENABLED=true
# RERANK_TIMEOUT=12.0        # exceeded -> keep the retrieval order
# RERANK_CANDIDATES=24       # shortlist size; rerank.py caps at 30 regardless

# Raw dialogue turns sent alongside the six-slot plan. Deliberately small: the
# plan IS the memory (app/plan.py), and this window only carries tone and "what
# did I just say". It was 8 before the plan existed, and the model had to
# re-derive the plan from scrollback on every turn.
# ASSISTANT_HISTORY_TURNS=4

# Conversational state is stored in the assistant_sessions table when
# DATABASE_URL is set, and in a bounded in-process dict otherwise — so the
# assistant keeps working with no Postgres, it just forgets on restart.

# --- Observability: LangSmith tracing ---------------------------------------
# A key turns each chat turn into a LangSmith trace of the whole pipeline
# (parse -> plan merge -> retrieve -> rerank -> generate, with real inputs and
# outputs at every stage). Unset = tracing off; /metrics and
# /admin/observability keep serving the in-process numbers either way.
# LANGSMITH_API_KEY=            # https://smith.langchain.com -> Settings -> API Keys
# LANGSMITH_PROJECT=traveliq-assistant
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # or https://eu.api.smith.langchain.com

# Comma-separated is not parsed; edit app/config.py if you need different origins.
# CORS defaults to the Vite dev server (http://localhost:5173).
